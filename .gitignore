# ============================================================
# KiCad
# ============================================================
# Autosave / backup files
*.kicad_sch-bak
*.kicad_pcb-bak
*.kicad_pro-bak
*.bak
*.tmp
*-backups/
*_autosave-*

# KiCad cached library tables
fp-lib-table
sym-lib-table

# KiCad local settings (machine-specific)
*.kicad_prl

# ============================================================
# KiCad file history (VSCode KiCad extension artefacts)
# ============================================================
.history/

# ============================================================
# Operating System
# ============================================================
# Windows
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# ============================================================
# Editors
# ============================================================
# VSCode
.vscode/

# JetBrains
.idea/

# ============================================================
# Firmware / ESP-IDF
# ============================================================
firmware/build/
firmware/dist/
firmware/managed_components/
firmware/dependencies.lock

# ============================================================
# Manufacturing outputs — keep gerbers/ tracked, but ignore
# intermediate zip archives if generated locally
# ============================================================
*.zip

# ESP-IDF generated configuration (derived from sdkconfig.defaults)
firmware/sdkconfig
firmware/sdkconfig.*
!firmware/sdkconfig.defaults
